{% extends 'oragePage.html.twig' %}

{% block title %}Accueil - ORAGE {% endblock %}
{% block stylesheets %}
    {# Lien vers le fichier CSS spécifique à la page d'accueil #}
    <link rel="stylesheet" href={{ asset("styles/home.css") }}>
{% endblock %}

{% block navbody %}
    {% include "component/flashRenderer.html.twig" %}
    <div class="container-wrapper">
        {# Section d'introduction / Hero #}
        {% set banner_title = "Bienvenue chez <span class='hero-highlight'>ORAGE</span>" %}
        {% set banner_description = '<p class="hero-subtitle">
                Apprendre ensemble, sans barrières. <br/>
                Découvrez nos missions.
            </p>
            <div class="hero-actions">
                <a href="#missions" class="hero-button">
                    En savoir plus
                </a>
            </div>' %}
        {% include "component/banner.html.twig" %}

        {# Section Missions et Objectifs #}
        <section id="missions" class="missions-section orage-section-margin">
            <h2 class="section-title">Nos Missions et Objectifs</h2>
            <div class="missions-grid">
                {# Mission 1 #}
                <div class="mission-card">
                    <div class="mission-icon icon-light">💡</div> {# Icône placeholder #}
                    <h3 class="mission-title">Favoriser l'Accès à la Connaissance</h3>
                    <p class="mission-description">
                        Nous nous engageons à rendre l'éducation accessible à tous, en développant des ressources
                        pédagogiques gratuites.
                    </p>
                </div>
                {# Mission 2 #}
                <div class="mission-card">
                    <div class="mission-icon icon-book">📚</div> {# Icône placeholder #}
                    <h3 class="mission-title">Soutenir l'étudiant</h3>
                    <p class="mission-description">
                        Notre objectif est d'accompagner chacun dans son parcours académique, en lui fournissant les
                        outils nécessaires à la réussite.
                    </p>
                </div>
                {# Objectif 1 #}
                <div class="mission-card">
                    <div class="mission-icon icon-handshake">🤝</div> {# Icône placeholder #}
                    <h3 class="mission-title">Apprendre ensemble</h3>
                    <p class="mission-description">
                        Nous bâtissons un réseau de partage et de collaboration où chacun peut apprendre et contribuer
                        activement.
                    </p>
                </div>
            </div>
        </section>

        {# Section Derniers Ajouts (Cours & Exercices) #}
        <section class="latest-additions-section orage-section-margin">
            <h2 class="section-title">Nos Derniers Ajouts</h2>
            <div class="latest-additions-grid">
                {# Dernier Cours #}
                {% if dernierCours %}
                    <div class="addition-card">
                        <div class="addition-image" style="
                            background: {{ dernierCours.categorie.color }};
                            height: 200px;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: white;
                            font-weight: bold;
                            font-size: 1.1em;
                            text-align: center;
                            padding: 0.5em;
                            line-height: 1.3;
                            ">
                            {{ dernierCours.nomCours }}
                        </div>
                        <h3 class="addition-title">Nouveau Cours : {{ dernierCours.nomCours }}</h3>
                        <p class="addition-description">
                            Cours de <strong>{{ dernierCours.categorie.libele }}</strong>
                            pour le niveau <strong>{{ dernierCours.niveau.nomNiveau }}</strong>.
                        </p>

                        {# Recherche du premier dépôt disponible #}
                        {% set firstDepot = dernierCours.firstAvailableDepot %}

                        {% if firstDepot %}
                            <a href="{{ path('app_depot_show_latest', {'identifier': firstDepot.identifier}) }}" class="addition-link">
                                Accéder au cours →
                            </a>
                        {% else %}
                            <span class="addition-link disabled">Bientôt disponible</span>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="addition-card">
                        <div class="addition-image" style="background: #e0e0e0; height: 200px; display: flex; align-items: center; justify-content: center; color: #666;">
                            Aucun cours
                        </div>
                        <h3 class="addition-title">Aucun cours disponible</h3>
                        <p class="addition-description">Les premiers cours seront bientôt en ligne !</p>
                    </div>
                {% endif %}

                {# Dernier Exercice - Section à compléter selon vos besoins #}
                <div class="addition-card">
                    <div class="addition-image" style="background: #f0f0f0; height: 200px; display: flex; align-items: center; justify-content: center; color: #666;">
                        <i class="fas fa-clipboard-list" style="font-size: 3em;"></i>
                    </div>
                    <h3 class="addition-title">Nouveaux Exercices</h3>
                    <p class="addition-description">
                        Des exercices pratiques pour consolider vos apprentissages seront bientôt disponibles.
                    </p>
                    <a href="{{ path('exercices') }}" class="addition-link">Découvrir les exercices →</a>
                </div>
            </div>
        </section>


        {# Section Dernières Nouveautés (Événements) #}
        <section class="latest-news-section orage-section-margin">
            <h2 class="section-title">Nos Dernières Nouveautés</h2>

            <div class="latest-news-grid">
                {# Nouveauté 1 : Événement #}
                {% for ann in annonces %}
                    {% if ann.visible %}
                        {% set visibility = "<span class='text-success'>Visible</span>" %}
                    {% else %}
                        {% set visibility = "<span class='text-danger'>Caché </span>" %}
                    {% endif %}
                    {% if ann.expirateAt < "now"|date("Y-m-d H:i:s") %}
                        {% set visibility = "<span class='text-danger'>Expiré </span>" %}
                    {% endif %}
                    <div class="news-card">
                        <div class="news-icon icon-announcement">📢</div> {# Icône annonce #}
                        <div>
                            <h3 class="news-title">{{ ann.title }}</h3>
                            <p class="news-description">
                                {{ ann.slug }}
                            </p>
                            <p class="news-date">{{ ann.createdAt|format_datetime(locale='fr',pattern="EEEE dd MMMM YYYY") }}</p>
                            <a href={{ url('article', {'id' : ann.id})}} class="news-link">Lire l'article</a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    </div>
{% endblock %}
